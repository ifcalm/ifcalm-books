      "wiki_text_sha256": "9fc4333fbd1169025e626ebb3247c0d5a9b23a02f81cf75c8026afd5c8792295",
      "paragraphs": 8,
      "summary": "欲静则平气，欲神则顺心。"
    },
    {
      "number": 24,
      "title": "徐无鬼",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/xu-wu-gui.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%BE%90%E7%84%A1%E9%AC%BC&oldid=11117712",
      "wiki_revision": 11117712,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%BE%90%E7%84%A1%E9%AC%BC",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_024.txt",
      "kanripo_sha256": "67b89d1509e7961d87ea5521c8ee55f8bc839d9af58209e78c2048d1fa578f3c",
      "wiki_text_sha256": "bd5018f11fed003de9e95eff4866ff63a50209d3e537e6a4cb3610c164e50dce",
      "paragraphs": 14,
      "summary": "于蚁弃知，于鱼得计，于羊弃意。"
    },
    {
      "number": 25,
      "title": "则阳",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/ze-yang.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%89%87%E9%99%BD&oldid=11117713",
      "wiki_revision": 11117713,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%89%87%E9%99%BD",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_025.txt",
      "kanripo_sha256": "a88c286610fed46ac98ac01a2581a67ded916d7fd009d18c24ee675369aa9856",
      "wiki_text_sha256": "e436b5ed13fc6c6868d53d99b2b82c12ce15503aa1339ad10e9f28a92968a618",
      "paragraphs": 12,
      "summary": "今指马之百体而不得马，而马系于前者，立其百体而谓之马也。"
    },
    {
      "number": 26,
      "title": "外物",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/wai-wu.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%A4%96%E7%89%A9&oldid=11117714",
      "wiki_revision": 11117714,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%A4%96%E7%89%A9",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_026.txt",
      "kanripo_sha256": "6a6a9040782ddc11cb002fcb93ce150ed21da7eecb885c985c9d740f22cdb2da",
      "wiki_text_sha256": "cf14c26df72fd30043fc287ec097ea3e361d736feda0036ab07e154ae27d7c6f",
      "paragraphs": 8,
      "summary": "静然可以补病，眦𡟬可以休老，宁可以止遽。"
    },
    {
      "number": 27,
      "title": "寓言",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/yu-yan.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%AF%93%E8%A8%80&oldid=11117715",
      "wiki_revision": 11117715,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%AF%93%E8%A8%80",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_027.txt",
      "kanripo_sha256": "afda5fa037ed61f726df77cfba267879a10d5554f6ee0d6d8388233878e94e03",
      "wiki_text_sha256": "04e800669123fd095093f7f954592142c525ee05705e4e0885c6878660bbc928",
      "paragraphs": 7,
      "summary": "言无言，终身言，未尝言；终身不言，未尝不言。"
    },
    {
      "number": 28,
      "title": "让王",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/rang-wang.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E8%AE%93%E7%8E%8B&oldid=11117716",
      "wiki_revision": 11117716,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E8%AE%93%E7%8E%8B",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_028.txt",
      "kanripo_sha256": "acff0e1ca0e69b67b5392ee01aa0192aaf10ff8c4d697a1facecf71da7feb9a2",
      "wiki_text_sha256": "5e72d831246dc052e2361d5c8ad52b5e563f4302cbe3954c300be98a1d9f2ac6",
      "paragraphs": 18,
      "summary": "古之得道者，穷亦乐，通亦乐，所乐非穷通也，道德于此，则穷通为寒暑风雨之序矣。"
    },
    {
      "number": 29,
      "title": "盗跖",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/dao-zhi.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E7%9B%9C%E8%B7%96&oldid=11117717",
      "wiki_revision": 11117717,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E7%9B%9C%E8%B7%96",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_029.txt",
      "kanripo_sha256": "3f41319c60b83f1248c6e8e49166ef9faefee5b6bd0a5d78231c3ddcc367af33",
      "wiki_text_sha256": "203b031e2d5d3f543204075b8f6d9ced7e2fcb7312e6a2c208712c1b8f194c3e",
      "paragraphs": 11,
      "summary": "廉贪之实，非以迫外也，反监之度。"
    },
    {
      "number": 30,
      "title": "说剑",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/shuo-jian.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E8%AA%AA%E5%8A%8D&oldid=11117718",
      "wiki_revision": 11117718,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E8%AA%AA%E5%8A%8D",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_030.txt",
      "kanripo_sha256": "2d79bff2720f5b8ff49cc36540ed0fa5b8379170c79e72c9ca8a16d19028fd6b",
      "wiki_text_sha256": "f65bd5171a38cf66308ab906771f8742a448a2da58a2458fcbc64b00d2006e80",
      "paragraphs": 1,
      "summary": "臣之劒，十步一人，千里不留行。"
    },
    {
      "number": 31,
      "title": "渔父",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/yu-fu.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E6%BC%81%E7%88%B6&oldid=11117719",
      "wiki_revision": 11117719,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E6%BC%81%E7%88%B6",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_031.txt",
      "kanripo_sha256": "34d5089ad55babfeb85140c8c4fe1b0561db2ba4c697284065321c6dc6063fb5",
      "wiki_text_sha256": "0715f374329bc8f447fe05743a52cd57ae31f8e2fa0908b0bdb55440be0a1915",
      "paragraphs": 5,
      "summary": "真者，精诚之至也。不精不诚，不能动人。故强哭者，虽悲不哀；强怒者，虽严不威；强亲者，虽笑不和。真悲无声而哀，真怒未发而威，真亲未笑而和。真在内者，神动于外，是所以贵真也。"
    },
    {
      "number": 32,
      "title": "列御寇",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/lie-yu-kou.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%88%97%E7%A6%A6%E5%AF%87&oldid=11117720",
      "wiki_revision": 11117720,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%88%97%E7%A6%A6%E5%AF%87",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_032.txt",
      "kanripo_sha256": "47cf9ce80adde5fad157845ed5038aea5650fa6af0fdb39097e43418996dc334",
      "wiki_text_sha256": "e5be729d2a4d609dc097c3fe6b0a53e83bed10508528b3f96e9d138afdce29d7",
      "paragraphs": 12,
      "summary": "凡人心险于山川，难于知天。天犹有春秋冬夏旦暮之期，人者厚貌深情"
    },
    {
      "number": 33,
      "title": "天下",
      "part": "杂篇",
      "path": "content/posts/taoism/zhuangzi/tian-xia.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E5%A4%A9%E4%B8%8B&oldid=11117721",
      "wiki_revision": 11117721,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%A4%A9%E4%B8%8B",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_033.txt",
      "kanripo_sha256": "71e13f3b9914d15cecd41d512dfd109f4b366438257b2eac222c66eda7e41187",
      "wiki_text_sha256": "1463a54c83f17d865f55ef76eb049ea9a96bf99dc0ce62b7b43384d098718ebd",
      "paragraphs": 13,
      "summary": "不累于俗，不饰于物，不苟于人，不忮于众。"
    }
  ],
