      "wiki_text_sha256": "e118432e41a51be08d1b918dc8296f73d8c1237c2aaf249927e62809aa2c1e90",
      "paragraphs": 11,
      "summary": "其耆欲深者，其天机浅。"
    },
    {
      "number": 7,
      "title": "应帝王",
      "part": "内篇",
      "path": "content/posts/taoism/zhuangzi/ying-di-wang.md",
      "wiki_url": "https://zh.wikisource.org/w/index.php?title=%E8%8E%8A%E5%AD%90%2F%E6%87%89%E5%B8%9D%E7%8E%8B&oldid=11117690",
      "wiki_revision": 11117690,
      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E6%87%89%E5%B8%9D%E7%8E%8B",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_007.txt",
