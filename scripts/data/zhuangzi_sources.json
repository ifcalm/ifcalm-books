      "wiki_original_url": "https://zh.wikisource.org/wiki/%E8%8E%8A%E5%AD%90/%E5%BE%B7%E5%85%85%E7%AC%A6",
      "kanripo_url": "https://raw.githubusercontent.com/kanripo/KR5c0126/abb9cd323dfd9520894b56b3b8ba2ec0ea50554f/KR5c0126_005.txt",
